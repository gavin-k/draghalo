<?xml version="1.0" encoding="utf-8"?>
<!--
  设计令牌，与 docs/design/README.md 保持一致。
  浅色 / 深色由 ThemeDictionaries 切换；高对比不走 XAML，由 AppStyles 按系统 UIElementColor 解析。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="DwAccent">#0067D9</Color>
      <Color x:Key="DwAccentHover">#0054B3</Color>
      <Color x:Key="DwAccentSoft">#E5F0FF</Color>
      <Color x:Key="DwAccentLine">#0067D9</Color>
      <Color x:Key="DwOnAccent">#FFFFFF</Color>
      <Color x:Key="DwSuccess">#0F7B3E</Color>
      <Color x:Key="DwWarning">#8A4B00</Color>
      <Color x:Key="DwDanger">#B42318</Color>
      <Color x:Key="DwBg">#F4F6FA</Color>
      <Color x:Key="DwSurface">#FFFFFF</Color>
      <Color x:Key="DwSurface2">#F7F9FC</Color>
      <Color x:Key="DwBorder">#DCE2EB</Color>
      <Color x:Key="DwBorderStrong">#B9C4D4</Color>
      <Color x:Key="DwText">#182333</Color>
      <Color x:Key="DwText2">#536073</Color>
      <Color x:Key="DwText3">#626E7D</Color>
      <Color x:Key="SystemAccentColor">#0067D9</Color>
      <Color x:Key="SystemAccentColorDark1">#0067D9</Color>
      <Color x:Key="SystemAccentColorDark2">#0054B3</Color>
      <Color x:Key="SystemAccentColorDark3">#003E85</Color>
      <Color x:Key="SystemAccentColorLight1">#8BC0FF</Color>
      <Color x:Key="SystemAccentColorLight2">#B8D9FF</Color>
      <Color x:Key="SystemAccentColorLight3">#E5F0FF</Color>
      <SolidColorBrush x:Key="DwBgBrush" Color="{StaticResource DwBg}" />
      <SolidColorBrush x:Key="DwSurfaceBrush" Color="{StaticResource DwSurface}" />
      <SolidColorBrush x:Key="DwSurface2Brush" Color="{StaticResource DwSurface2}" />
      <SolidColorBrush x:Key="DwBorderBrush" Color="{StaticResource DwBorder}" />
      <SolidColorBrush x:Key="DwTextBrush" Color="{StaticResource DwText}" />
      <SolidColorBrush x:Key="DwText2Brush" Color="{StaticResource DwText2}" />
      <SolidColorBrush x:Key="DwText3Brush" Color="{StaticResource DwText3}" />
      <SolidColorBrush x:Key="DwAccentBrush" Color="{StaticResource DwAccent}" />
      <SolidColorBrush x:Key="DwAccentSoftBrush" Color="{StaticResource DwAccentSoft}" />
      <SolidColorBrush x:Key="DwOnAccentBrush" Color="{StaticResource DwOnAccent}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <Color x:Key="DwAccent">#8BC0FF</Color>
      <Color x:Key="DwAccentHover">#B8D9FF</Color>
      <Color x:Key="DwAccentSoft">#163A63</Color>
      <Color x:Key="DwAccentLine">#8BC0FF</Color>
      <Color x:Key="DwOnAccent">#092546</Color>
      <Color x:Key="DwSuccess">#4ADE80</Color>
      <Color x:Key="DwWarning">#FBBF24</Color>
      <Color x:Key="DwDanger">#F87171</Color>
      <Color x:Key="DwBg">#151A22</Color>
      <Color x:Key="DwSurface">#202733</Color>
      <Color x:Key="DwSurface2">#273140</Color>
      <Color x:Key="DwBorder">#3C485A</Color>
      <Color x:Key="DwBorderStrong">#61718A</Color>
      <Color x:Key="DwText">#F4F7FC</Color>
      <Color x:Key="DwText2">#C5CFDD</Color>
      <Color x:Key="DwText3">#AAB7C9</Color>
      <Color x:Key="SystemAccentColor">#0067D9</Color>
      <Color x:Key="SystemAccentColorDark1">#0067D9</Color>
      <Color x:Key="SystemAccentColorDark2">#0054B3</Color>
      <Color x:Key="SystemAccentColorDark3">#003E85</Color>
      <Color x:Key="SystemAccentColorLight1">#8BC0FF</Color>
      <Color x:Key="SystemAccentColorLight2">#B8D9FF</Color>
      <Color x:Key="SystemAccentColorLight3">#E5F0FF</Color>
      <SolidColorBrush x:Key="DwBgBrush" Color="{StaticResource DwBg}" />
      <SolidColorBrush x:Key="DwSurfaceBrush" Color="{StaticResource DwSurface}" />
      <SolidColorBrush x:Key="DwSurface2Brush" Color="{StaticResource DwSurface2}" />
      <SolidColorBrush x:Key="DwBorderBrush" Color="{StaticResource DwBorder}" />
      <SolidColorBrush x:Key="DwTextBrush" Color="{StaticResource DwText}" />
      <SolidColorBrush x:Key="DwText2Brush" Color="{StaticResource DwText2}" />
      <SolidColorBrush x:Key="DwText3Brush" Color="{StaticResource DwText3}" />
      <SolidColorBrush x:Key="DwAccentBrush" Color="{StaticResource DwAccent}" />
      <SolidColorBrush x:Key="DwAccentSoftBrush" Color="{StaticResource DwAccentSoft}" />
      <SolidColorBrush x:Key="DwOnAccentBrush" Color="{StaticResource DwOnAccent}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>


  <Style TargetType="Button">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- Geometry -->
  <CornerRadius x:Key="DwControlRadius">8</CornerRadius>
  <CornerRadius x:Key="DwCardRadius">12</CornerRadius>
  <!-- The wheel's sizes are in WheelGeometry (DropHalo.Core), which both draws it and hit-tests it. -->

  <!-- Motion (ms). 全部受 UISettings.AnimationsEnabled 控制 -->
  <x:Double x:Key="DwMotionWheelIn">100</x:Double>
  <x:Double x:Key="DwMotionSelect">70</x:Double>
  <x:Double x:Key="DwMotionCheck">320</x:Double>
</ResourceDictionary>
