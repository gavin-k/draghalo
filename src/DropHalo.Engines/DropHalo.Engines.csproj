<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DropHalo.Engines</RootNamespace>
    <Description>Engine adapters implementing IConverter. Heavy engines (ffmpeg, soffice) run as sidecar processes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DropHalo.Core/DropHalo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/L.cs" Link="L.cs" />
    <EmbeddedResource Include="Strings.*.json" LogicalName="%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q16-AnyCPU" />
    <PackageReference Include="PDFtoImage" />
    <PackageReference Include="PdfPig" />
    <!-- <PackageReference Include="DocumentFormat.OpenXml" /> -->
    <PackageReference Include="SharpCompress" />
  </ItemGroup>

</Project>
